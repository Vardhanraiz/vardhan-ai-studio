# ==============================================================================
# Vardhan AI Studio - Environment Configuration Template
# Copy this file to `.env` and adjust values as needed.
# Core features are 100% local-first and require NO paid API keys.
# ==============================================================================

# Application
APP_NAME="Vardhan AI Studio"
APP_ENV=development
APP_DEBUG=true

# Backend Server (localhost-only by default for security)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Dev Server
FRONTEND_PORT=5173

# Workspace Sandboxing (all file & terminal operations are restricted here)
WORKSPACE_ROOT=./workspace
BACKUP_DIR=./.vardhan_backups
MAX_FILE_SIZE_KB=1024

# Database (SQLite by default; PostgreSQL supported later via SQLAlchemy)
DATABASE_URL=sqlite:///./vardhan_studio.db

# Local AI Provider (Ollama - Free & Local, Optimized for 8 GB RAM)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:1.5b
OLLAMA_REQUEST_TIMEOUT_SEC=120

# Security
# Enable API token auth if binding BACKEND_HOST to a non-localhost interface
API_AUTH_ENABLED=false
API_SECRET_KEY=change-me-before-enabling-network-access

# ------------------------------------------------------------------------------
# OPTIONAL External / Cloud Providers (NOT required for core functionality)
# Using external cloud APIs may incur provider charges.
# ------------------------------------------------------------------------------
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
